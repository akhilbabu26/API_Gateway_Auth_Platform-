# ==============================================================================
# Environment Configuration Template (Copy to .env for local/EC2 configuration)
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Environment: development or production
APP_ENV=development

# Service Port (Default: 8081)
AUTH_PORT=8081

# Allowed CORS Origins:
# In development: defaults to localhost (http://localhost:3000,http://localhost:5173)
# In production: MUST be explicitly set to your frontend domain (e.g. https://your-app.vercel.app)
# Wildcard '*' is strictly forbidden in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=apigateway_auth
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Full connection string for Auth Service
DATABASE_URL=postgres://postgres:your_secure_postgres_password_here@postgres:5432/apigateway_auth?sslmode=disable

# Redis Cache & OTP Storage Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Cryptographic Secrets
# Generate on host with: openssl rand -base64 32 (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key_for_production
JWT_ISSUER=apigateway-auth-service
